# Prevent any uploaded file from being executed as a script.
# This protects against disguised PHP/CGI uploads even if a future bug ever lets one slip past the MIME/extension checks # in src/upload.php and public/register.php.

# Disable PHP execution in this directory (Apache + mod_php)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Belt-and-suspenders: refuse to serve common script extensions at all, regardless of how PHP is wired into Apache (e.g. # via FPM/CGI handlers).
<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl|py|sh|exe)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes
